<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Android's declarative cleartext policy can whitelist only exact domains, not private CIDR ranges.
        We keep cleartext opt-in isolated to this dedicated config and enforce the actual LAN/private-host
        restriction again in LanClient before every request: only 192.168.x.x, 10.x.x.x, 172.16-31.x.x,
        localhost, and 127.0.0.1 are accepted.
    -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
