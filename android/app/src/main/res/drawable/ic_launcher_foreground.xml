<?xml version="1.0" encoding="utf-8"?>
<!--
    Primo piano dell'icona: una card dentro un ciclo chiuso.

    Prima versione scartata: la card occupava quasi tutto e i due archi ai lati
    si leggevano come parentesi, mentre la punta della freccia in basso si
    fondeva con l'arco e faceva sembrare il tutto un fumetto di chat. Qui la
    card e' piu' piccola e il ciclo e' un anello unico e continuo, con uno
    stacco netto fra le due forme.

    Tutto sta nel riquadro centrale 66x66 (da 21 a 87): i launcher ritagliano
    il bordo esterno, quindi fuori di li' non c'e' garanzia che si veda.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        L'anello: quasi un giro completo, con l'apertura in alto a destra dove
        entra la punta. Tracciato in senso antiorario partendo poco sotto
        l'apertura.
    -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M76,40 A28,28 0 1 0 78,64" />

    <!-- Punta della freccia, staccata dall'anello: da' il verso al ciclo. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M70,36 L86,38 L76,50 Z" />

    <!-- La card, piccola e centrata: si stacca bene dall'anello. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M41,43 h26 a4,4 0 0 1 4,4 v14 a4,4 0 0 1 -4,4 h-26 a4,4 0 0 1 -4,-4 v-14 a4,4 0 0 1 4,-4 z" />

    <!-- Due righe di testo accennate, nel viola del tema. -->
    <path
        android:fillColor="#FF4A3FD0"
        android:pathData="M44,49 h20 v3 h-20 z" />
    <path
        android:fillColor="#994A3FD0"
        android:pathData="M44,56 h12 v3 h-12 z" />
</vector>
