<?xml version="1.0" encoding="utf-8"?>
<!--
    Sfondo dell'icona adattiva: 108x108, ma i launcher possono ritagliarne i
    bordi in forme diverse (cerchio, quadrato stondato, goccia). Per questo lo
    sfondo e' pieno e senza dettagli: qualunque ritaglio deve restare
    riconoscibile. Il disegno vero sta tutto nel primo piano.

    Il viola e' lo stesso `primary` del tema, cosi' icona e app si assomigliano.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF6C5FF0" />
                <item android:offset="1" android:color="#FF4A3FD0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
