# Copy this file to android/keystore.properties and fill in the four values. Do not commit it.
# Generate the key once, for example:
# keytool -genkeypair -v -keystore mindloop-release.jks -alias mindloop -keyalg RSA -keysize 2048 -validity 10000
# Keep the keystore and its passwords safe forever: losing this key prevents publishing app updates.
storeFile=
storePassword=
keyAlias=
keyPassword=
